<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Evaluacion4charlottegabriel" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mystic_purple</item>
        <item name="colorPrimaryVariant">@color/mystic_indigo</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/mystic_gold</item>
        <item name="colorSecondaryVariant">@color/mystic_purple_light</item>
        <item name="colorOnSecondary">@color/mystic_dark</item>
        <item name="android:colorBackground">#FFF7F0</item>
        <item name="android:statusBarColor">@color/mystic_dark</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/mystic_deep_purple</item>
        <item name="android:textColorSecondary">@color/mystic_indigo</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextStyle.Title" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textColor">@color/mystic_deep_purple</item>
        <item name="android:textSize">36sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="TextStyle.Subtitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/mystic_indigo</item>
        <item name="android:textSize">18sp</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="TextStyle.Description" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/mystic_deep_purple</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="CardStyle.Mystic" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">#FAFFFDFC</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">8dp</item>
        <item name="strokeColor">@color/mystic_gold</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="ButtonStyle.Mystic" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/mystic_gold</item>
        <item name="android:textColor">@color/mystic_deep_purple</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">18dp</item>
    </style>
</resources>
